@book{gollJavaServerFacesJSF2020,
  title = {{JavaServer Faces: JSF verstehen und praktisch einsetzen}},
  shorttitle = {{JavaServer Faces}},
  author = {Goll, Michael},
  year = 2020,
  edition = {3., \"uberarbeitete Auflage},
  publisher = {Springer Vieweg},
  address = {Wiesbaden},
  abstract = {Dieses Buch erm\"oglicht Ihnen durch einfache Formulierungen und zahlreiche Grafiken einen schnellen Einstieg in die JSF-Technologie. Der Schwerpunkt liegt dabei auf der lebendigen und abwechslungsreichen Vermittlung von Wissen und weniger auf formal korrekter Beschreibung. Nach der Durcharbeitung sind Ihnen die grundlegenden Konzepte des JSF-Rahmenwerks bekannt und Sie k\"onnen diese bei der Erstellung von Webanwendungen problemgerecht einsetzen. Der Umgang mit JSF wird anhand zahlreicher kleiner Beispiele und einer durchg\"angigen Fallstudie erl\"autert, die durch die jeweils pr\"asentierten Konzepte erweitert wird. Der Inhalt Grundlagen der Webentwicklung Java-Webentwicklung mit Servlets und JSP-Seiten JavaServer Faces Grundlegende JSF-Komponenten Templating Internationalisierung Navigation Konverter Validierung Listener Erweiterte Komponenten Komponentenbaum Der JSF-Lebenszyklus und um die JSF-Anwendung Konfigurationsdateien Verwaltung von Ressourcen Asynchronous JavaScript and XML HTML5 Friendly Markup WebSocket JSON Verarbeitung Wiederverwendung Faces Flows JSF-Kern erweitern Der Autor Dr. Michael Goll besch\"aftigt sich seit l\"angerer Zeit beruflich mit dem Thema Programmierung von Webanwendungen und besitzt langj\"ahrige industrielle Praxis in Entwicklung und Architektur von gro\ss en Softwaresystemen},
  isbn = {978-3-658-31802-4}
}

