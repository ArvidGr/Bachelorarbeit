@article{moePerspectivesTraceabilityFood1998,
  title = {Perspectives on Traceability in Food Manufacture},
  author = {Moe, T.},
  year = 1998,
  journal = {Trends in Food Science \& Technology},
  volume = {9},
  number = {5},
  pages = {211--214},
  issn = {0924-2244},
  abstract = {Traceability in food manufacturing can range from in-house traceability in production plants to traceability in whole or part of the production chain from raw material to consumer, and descriptors of the product and its history can be few or many as decided. Well thought-out traceability systems are fundamental to achieving optimal benefits from quality control, production control and for fulfilling consumer demands etc. In order to facilitate the discussion of a traceability strategy in food industries this Viewpoint outlines the fundamental theoretical issues of traceability systems and presents a more practical discussion of its extent.}
}

@incollection{yilmazTransparenzUndRueckverfolgbarkeit2022,
  title = {{Transparenz und R\"uckverfolgbarkeit}},
  booktitle = {{Blockchain-Implementierung in eine Automotive Supply Chain}},
  author = {Yilmaz, Erhan and Meyh{\"o}fer, Sven and {Sanchez-Gonzalez}, Henrik and Goudz, Alexander},
  year = 2022,
  series = {{essentials}},
  pages = {9--13},
  publisher = {Springer Fachmedien},
  address = {Wiesbaden},
  abstract = {Die Transparenz im Allgemeinen ist der Zustand, in dem Dinge von allen Beteiligten gleicherma\ss en wahrgenommen werden, sodass ein Konsens \"uber die wahre Erscheinung herrscht. Bezogen auf den \"okonomischen Kontext ist Transparenz die F\"ahigkeit eines Auftraggebers zu beobachten, wie sich ein Auftragnehmer verh\"alt und welche Konsequenzen sein Verhalten hat. Anders ausgedr\"uckt, es geht um die Offenheit, die Kommunikation und um all die Themen, die die Betroffenen als wichtig erachten.},
  isbn = {978-3-658-38181-3}
}
